{
  // Copy to deployment.oauth.secrets.jsonc (gitignored) and replace every placeholder.
  // Callback for each: https://os.samabrains.com/gatekeeper/<short>/oauth
  // Homepage: https://os.samabrains.com
  //
  // Then: pnpm exec tsx scripts/put-gatekeeper-secrets.ts

  "github": {
    "CLIENT_ID": "<GITHUB_OAUTH_CLIENT_ID>",
    "CLIENT_SECRET": "<GITHUB_OAUTH_CLIENT_SECRET>"
  },
  "google": {
    "CLIENT_ID": "<GOOGLE_OAUTH_CLIENT_ID>",
    "CLIENT_SECRET": "<GOOGLE_OAUTH_CLIENT_SECRET>"
  },
  "notion": {
    "CLIENT_ID": "<NOTION_OAUTH_CLIENT_ID>",
    "CLIENT_SECRET": "<NOTION_OAUTH_CLIENT_SECRET>"
  },
  "slack": {
    "CLIENT_ID": "<SLACK_OAUTH_CLIENT_ID>",
    "CLIENT_SECRET": "<SLACK_OAUTH_CLIENT_SECRET>"
  },
  "cloudflare": {
    "CLIENT_ID": "<CLOUDFLARE_OAUTH_CLIENT_ID>",
    "CLIENT_SECRET": "<CLOUDFLARE_OAUTH_CLIENT_SECRET>"
  },
  "confluence": {
    "CLIENT_ID": "<CONFLUENCE_OAUTH_CLIENT_ID>",
    "CLIENT_SECRET": "<CONFLUENCE_OAUTH_CLIENT_SECRET>"
  },
  "linear": {
    "CLIENT_ID": "<LINEAR_OAUTH_CLIENT_ID>",
    "CLIENT_SECRET": "<LINEAR_OAUTH_CLIENT_SECRET>"
  },
  "supabase": {
    "CLIENT_ID": "<SUPABASE_OAUTH_CLIENT_ID>",
    "CLIENT_SECRET": "<SUPABASE_OAUTH_CLIENT_SECRET>"
  }
}
